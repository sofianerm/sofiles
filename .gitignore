# The repository contains our source tools, never third-party binaries or profiles.
/*
!/.gitignore
!/README.md
!/PRODUCT.md
!/DESIGN.md
!/SOFILES.md
!/docs/
!/release-notes/
!/config/
!/src/
!/assets/
!/tools/
!/analysis/
/tools/*
!/tools/build_sofiles.py
!/tools/build_sofiles_full.py
!/tools/build_sofiles_product.py
!/tools/verify_sofiles_full.py
!/tools/sofiles_dialog_resources.py
!/tools/sofiles_product_content.py
!/tools/create_sofiles_icon.py
!/tools/test_sofiles_product.py
!/tools/new_sofiles_signing_key.ps1
!/tools/sign_sofiles_release.ps1
/analysis/*
!/analysis/branding/
/analysis/branding/*
!/analysis/branding/full-native/
!/analysis/branding/full-locales/
/analysis/branding/full-native/*
!/analysis/branding/full-native/native-branding-inventory.json
!/analysis/branding/full-native/length-fixups.json
/analysis/branding/full-locales/*
!/analysis/branding/full-locales/fr-overrides.json
/assets/*
!/assets/sofiles/
/assets/sofiles/*
!/assets/sofiles/sofiles.svg
!/assets/sofiles/sofiles.ico
!/assets/sofiles/sofiles-about-190x145.png
**/__pycache__/
**/*.pyc
**/bin/
**/obj/
/.private/
/dist/
/builds/
/.impeccable/
